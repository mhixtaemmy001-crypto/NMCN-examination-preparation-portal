{
  "entities": {
    "user": {
      "title": "Candidate User",
      "description": "Registered and verified candidate account for NMCN examination portal",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Candidate unique ID or UID" },
        "name": { "type": "string", "description": "Candidate full legal name" },
        "email": { "type": "string", "format": "email", "description": "Candidate registered email address" },
        "idNumber": { "type": "string", "description": "College candidate matriculation / index number" },
        "department": { "type": "string", "description": "College academic department" },
        "isVerified": { "type": "boolean", "description": "Whether candidate passed email OTP verification" },
        "boundDeviceId": { "type": "string", "description": "ID of bound hardware device" },
        "verifiedAt": { "type": "number", "description": "Timestamp of email verification" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["uid", "name", "email", "isVerified"]
    },
    "otpVerification": {
      "title": "OTP Verification Record",
      "description": "Secure server-side hashed OTP verification record with expiration and rate limiting",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Candidate email receiving OTP" },
        "hashedOtp": { "type": "string", "description": "Cryptographic SHA-256 hash of OTP code" },
        "salt": { "type": "string", "description": "Per-session cryptographic salt" },
        "attempts": { "type": "number", "description": "Failed verification attempt counter" },
        "maxAttempts": { "type": "number", "description": "Max allowed incorrect attempts before lock" },
        "expiresAt": { "type": "number", "description": "Epoch timestamp when OTP expires (5 minutes)" },
        "verified": { "type": "boolean", "description": "Whether OTP was successfully validated" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["email", "hashedOtp", "salt", "attempts", "expiresAt", "verified"]
    },
    "examResult": {
      "title": "Examination Result",
      "description": "Record of a completed practice examination attempt by an accredited candidate",
      "type": "object",
      "properties": {
        "candidateName": { "type": "string", "description": "Full accredited name" },
        "candidateIndex": { "type": "string", "description": "Matriculation / index number" },
        "candidateEmail": { "type": "string", "description": "Candidate official email" },
        "deviceId": { "type": "string", "description": "Bound device identifier" },
        "questionTypeId": { "type": "string", "description": "Exam type identifier" },
        "questionTypeName": { "type": "string", "description": "Display name of exam type" },
        "score": { "type": "number", "description": "Number of correct answers" },
        "totalQuestions": { "type": "number", "description": "Total question count" },
        "percentage": { "type": "number", "description": "Percentage score achieved" },
        "timeSpentSeconds": { "type": "number", "description": "Seconds taken for exam" },
        "submittedAt": { "type": "number", "description": "Submission epoch timestamp" }
      },
      "required": ["candidateName", "candidateIndex", "questionTypeId", "score", "totalQuestions", "percentage", "submittedAt"]
    },
    "boundDevice": {
      "title": "Bound Device Record",
      "description": "Device hardware registration and candidate binding metadata",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "description": "Unique device identifier" },
        "deviceName": { "type": "string", "description": "Detected OS and device platform" },
        "candidateName": { "type": "string", "description": "Bound candidate full name" },
        "candidateIndex": { "type": "string", "description": "Bound candidate index number" },
        "candidateEmail": { "type": "string", "description": "Candidate email address" },
        "boundAt": { "type": "number", "description": "Timestamp when device was bound" },
        "lastSeenAt": { "type": "number", "description": "Timestamp of last candidate activity" }
      },
      "required": ["deviceId", "candidateName", "candidateIndex", "boundAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Candidate profiles accessible to owners and server"
    },
    "/otp_verifications/{verificationId}": {
      "schema": "otpVerification",
      "description": "Backend-only OTP records, denied from direct public client access"
    },
    "/exam_results/{resultId}": {
      "schema": "examResult",
      "description": "Candidate examination result submissions"
    },
    "/bound_devices/{deviceId}": {
      "schema": "boundDevice",
      "description": "Verified candidate bound device registry"
    }
  }
}
