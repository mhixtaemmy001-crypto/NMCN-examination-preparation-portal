# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TRANSACTIONAL EMAIL DELIVERY (for sending real 6-digit OTPs from NMCN Exam Portal)
# Configure either SMTP or Resend API key to deliver OTP verification emails to candidates:

# Option A: Standard SMTP (Gmail, Brevo, SendGrid, Amazon SES, or College Mail Server)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="exam-portal@your-college.edu.ng"
SMTP_PASS="your-app-password-or-smtp-key"
EMAIL_FROM="\"NMCN Examination Preparation Portal\" <no-reply@ascons.edu.ng>"

# Option B: Resend API (https://resend.com)
# RESEND_API_KEY="re_123456789"
