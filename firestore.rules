rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // OTP verification records: Strictly backend-authoritative.
    // Client SDK read/write is completely blocked to protect hashes, salts, and attempt counters.
    match /otp_verifications/{verificationId} {
      allow read, write: if false;
    }

    // Candidate user profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId)
                    && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'isVerified'])
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'idNumber', 'isVerified', 'verifiedAt', 'createdAt'])
                    && request.resource.data.uid == userId
                    && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 150
                    && request.resource.data.isVerified is bool;
      allow update: if isValidId(userId) && isOwner(userId)
                    && request.resource.data.uid == userId
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'idNumber', 'updatedAt']);
      allow delete: if false;
    }
  }
}
